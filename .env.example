# VoteVault environment template — inventory of variable names.
# Per-service copies: frontend/.env.example, backend/.env.example (authoritative values there).
# Never put real credentials in this file or in the repository.

# --- frontend (browser; public settings only) ---
VITE_API_BASE_URL
VITE_SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY

# --- backend ---
SUPABASE_URL
SUPABASE_JWKS_URL            # optional explicit JWKS override (derived from SUPABASE_URL by default)
SUPABASE_JWT_SECRET          # HS256 mode, local dev/tests ONLY; empty in production
SUPABASE_ANON_KEY            # public; enables /api/v1/auth/signup and /api/v1/auth/login
DATABASE_URL                 # Supabase PostgreSQL connection string (postgres role, not service_role)
CORS_ALLOWED_ORIGINS

# --- backend -> blockchain (Web3.py, Hardhat local chain) ---
BLOCKCHAIN_RPC_URL
BLOCKCHAIN_CHAIN_ID          # 31337 on Hardhat
BLOCKCHAIN_DEPLOYMENT_FILE   # deploy.js artifact (address + ABI + code hash); preferred source
BALLOT_REGISTRY_CONTRACT_ADDRESS  # fallback when no deployment artifact
LOCAL_CHAIN_SIGNER_PRIVATE_KEY   # relayer key; backend environment ONLY, never frontend/repo

# --- publication job tuning (optional, defaults in app/config.py) ---
PUBLICATION_MAX_ATTEMPTS
PUBLICATION_RETRY_DELAY_SECONDS
PUBLICATION_CONFIRMATIONS
PUBLICATION_RECEIPT_TIMEOUT_SECONDS
PUBLICATION_POLL_INTERVAL_SECONDS
RUN_BACKGROUND_PUBLISHER
