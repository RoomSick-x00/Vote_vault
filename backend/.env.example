# VoteVault backend — copy to .env and fill in. NEVER commit real values.
# Names match the root .env.example inventory plus backend tuning knobs.

# --- application ---
APP_ENV=development

# --- database (Supabase PostgreSQL) ---
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the pooler host for servers: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local fallback for development/tests only (SQLite):
# DATABASE_URL=sqlite:///./votevault-dev.db
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth ---
# Recommended: RS256 via the project JWKS (set SUPABASE_URL; JWKS URL is derived).
SUPABASE_URL=https://<project-ref>.supabase.co
# Optional explicit override:
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Alternative for local dev/tests only: HS256 shared JWT secret
# (Dashboard -> Project Settings -> API -> JWT Settings). Leave empty in production.
SUPABASE_JWT_SECRET=
# Public anon key (Dashboard -> Project Settings -> API). Enables the organizer
# signup/login proxy endpoints /api/v1/auth/signup and /api/v1/auth/login.
SUPABASE_ANON_KEY=
VOTER_SESSION_SECRET=
# NOTE: for the demo, turn OFF "Confirm email" in Supabase Auth settings, or
# signup returns 403 EMAIL_CONFIRMATION_REQUIRED until the address is confirmed.

# --- voter OTP delivery ---
# For real email set OTP_EMAIL_PROVIDER=smtp. Use an SMTP app password where
# required by your provider. Never commit credentials. Delivery uses TLS.
OTP_EMAIL_PROVIDER=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# For real SMS set OTP_PHONE_PROVIDER=twilio_verify and create a Verify service.
# A Twilio trial has verified-recipient, geography, quota and expiry restrictions.
OTP_PHONE_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional alternative: OTP_PHONE_PROVIDER=twilio (Messaging API; a configured
# SMS sender and account that permits your message body are required).
TWILIO_FROM_NUMBER=
# development providers return codes only in APP_ENV=development or test.
# In production they fail closed rather than returning codes.

# --- HTTP ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- blockchain (Hardhat local chain, chain id 31337) ---
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=31337
# Deployment artifact written by blockchain/scripts/deploy.js — the single
# source of truth for the contract address, ABI, and bytecode hash. When it
# exists it takes precedence over BALLOT_REGISTRY_CONTRACT_ADDRESS.
BLOCKCHAIN_DEPLOYMENT_FILE=blockchain/deployments/localhost.json
# Only used when the deployment artifact is absent.
BALLOT_REGISTRY_CONTRACT_ADDRESS=
# Relayer key (the manifest's relayer account) — backend environment ONLY.
# Never in the repo, never in the frontend.
LOCAL_CHAIN_SIGNER_PRIVATE_KEY=

# --- publication jobs (optional tuning; defaults shown) ---
PUBLICATION_MAX_ATTEMPTS=5
PUBLICATION_RETRY_DELAY_SECONDS=5
PUBLICATION_CONFIRMATIONS=1
PUBLICATION_RECEIPT_TIMEOUT_SECONDS=30
PUBLICATION_POLL_INTERVAL_SECONDS=2
RUN_BACKGROUND_PUBLISHER=true
